{
  "name": "organic-growth-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "personal": "node scripts/personal.mjs",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start -p ${PORT:-3010}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "clean": "rm -rf .next .next-dev",
    "smoke": "node scripts/smoke.mjs",
    "traffic:audit": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/traffic-audit.mjs",
    "catalog:ingest": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/ingest-catalog.mjs"
  },
  "dependencies": {
    "@next/env": "15.5.27",
    "jsdom": "^24.1.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.8.3",
    "vitest": "^1.3.0"
  }
}
