# Generate a different random value for each secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_ACCESS_TOKEN="replace-owner-access-token"
SESSION_SECRET="replace-session-signing-secret"
AUTOPILOT_TOKEN="replace-autopilot-bearer-token"
AUTOPILOT_BASE_URL="http://127.0.0.1:3010"
AUTOPILOT_MAX_CONCURRENCY="3"
DATA_DIR="./data"
# Set to "true" ONLY when a reverse proxy you control sets x-forwarded-for.
# Left unset, sign-in throttling counts every caller against one shared bucket,
# because an unproxied client can forge that header freely.
TRUST_PROXY_HEADER="false"
# The address people reach this Studio at. Tracked /go/ links are built from
# it, so behind a proxy it must be the public URL, not the listening address.
PUBLIC_BASE_URL="https://studio.example.com"
PORT="3010"
# Shopify Admin API, used by both pnpm catalog:ingest and pnpm orders:sync.
# One custom-app token covers both: create it in Shopify admin under Settings >
# Apps and sales channels > Develop apps, with read_products and read_orders.
# read_orders only reaches the last 60 days; a longer window needs
# read_all_orders. Leave unset to work from a saved API response.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_TOKEN=""
