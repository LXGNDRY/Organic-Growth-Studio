{
  "name": "organic-growth-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Personal organic discovery and distribution studio",
  "scripts": {
    "dev": "pnpm --filter organic-growth-studio dev",
    "start": "pnpm --filter organic-growth-studio start",
    "personal": "pnpm --filter organic-growth-studio personal",
    "build": "pnpm --filter organic-growth-studio build",
    "lint": "pnpm --filter organic-growth-studio lint",
    "typecheck": "pnpm --filter organic-growth-studio typecheck",
    "test": "pnpm --filter organic-growth-studio test",
    "test:ci": "pnpm --filter organic-growth-studio test:ci",
    "clean": "pnpm --filter organic-growth-studio clean",
    "smoke": "pnpm --filter organic-growth-studio smoke"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.6",
      "source-map-js": "^1.2.2"
    }
  }
}
